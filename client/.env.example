# Next.js Configuration
NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:5050
NEXT_PUBLIC_SERVER_URL=http://localhost:5050
NEXT_PUBLIC_CLIENT_URL=http://localhost:3030
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SSO_CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_SSO_SERVER_URL=http://localhost:8080
NEXT_PUBLIC_SSO_OAUTH_CLIENT_ID=gorth-interactive-messaging-portal
NEXT_AUTH_SECRET=
NEXT_SESSION_MAX_AGE_SECONDS=2592000

# Authentication Cookies
GORTH_ACCESS_TOKEN=gorth.access_token
GORTH_REFRESH_TOKEN=gorth.refresh_token
GORTH_OAUTH_STATE=gorth.oauth_state
GORTH_OAUTH_CODE_VERIFIER=gorth.oauth_code_verifier
GORTH_OAUTH_RETURN_TO=gorth.oauth_return_to
GORTH_OAUTH_ISSUER=gorth.oauth_issuer

# Development Configuration
NEXT_PUBLIC_DEBUG_AUTH=true
NEXT_PUBLIC_DEBUG_ROLES=manager,staff,customer
