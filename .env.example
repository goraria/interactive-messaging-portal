# Single Next.js + Hono application, local port 3030.
# Same-origin APIs use relative paths; no API_BASE_URL or SERVER_URL is needed.
# Vercel: set APP_URL to the exact stable https://<project>.vercel.app origin.
# Register that origin's /auth/callback/gorth at SSO; no wildcard callbacks.
# Configure Preview separately with a stable branch alias registered at SSO.
# All seven service origins below must be deployed HTTPS URLs on Vercel.
# Run bun run check:deployment to check values without printing secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3030
NEXT_PUBLIC_AUTH_URL=https://gorth-auth.vercel.app
# Public client registered in SSO; all SSO protocol endpoints share AUTH_URL.
# Must be a confidential SSO client supporting code + refresh + client_credentials with PKCE.
NEXT_OAUTH_CLIENT_ID=QFzSDJRFthaDjoppAjkEWlRRvhyjNGRa
# Same confidential identity for genericOAuth sign-in and scoped backend grants. Secret stays server-only.
NEXT_OAUTH_CLIENT_SECRET=7vSHtFcHXf7bm8WW6wyG6CjIoFjVVQnV
NEXT_OAUTH_COOKIE_PREFIX=gorth

# Server-only values. Chat's registered OAuth resource now matches its fullstack
# origin on port 3030; there is no separate Chat server.
# These NEXT_* root values are required; VITE_* in pkg/server are not loaded.
# OAuth resource identifier (not an upstream URL); must match registration in SSO.
NEXT_OAUTH_AUDIENCE=http://localhost:3030
# Keep the Chat audience above even when configuring the seven services below.
# Configure only audiences registered for this client in SSO.
# Notify/resource/discovery values also identify their direct HTTP service origin.
NEXT_OAUTH_NOTIFY_AUDIENCE=http://localhost:5052
NEXT_OAUTH_RESOURCE_AUDIENCE=http://localhost:5053
NEXT_OAUTH_DISCOVERY_AUDIENCE=http://localhost:5054
NEXT_OAUTH_PAYMENT_AUDIENCE=http://localhost:5055
NEXT_OAUTH_BILLING_AUDIENCE=http://localhost:5056
NEXT_OAUTH_MEDIA_AUDIENCE=http://localhost:5057
NEXT_OAUTH_INSIGHT_AUDIENCE=http://localhost:5058
# Optional: requires an explicitly linked/authorized Commerce resource at SSO.
NEXT_OAUTH_COMMERCE_AUDIENCE=
# Better Auth's local session/token-encryption secret (at least 32 bytes).
# Existing secret can remain; legacy custom sessions require sign-in again.
NEXT_SESSION_SECRET=
NEXT_SESSION_MAX_AGE_SECONDS=2592000
DATABASE_URL=
PG_POOL_MAX=5
# If this matches the Next origin port, Hono uses private loopback 3037.
# The browser still connects to Next on 3030; no second bind on that port.
# bun run dev/start calls plain next dev/start. No extra launcher or process.
# Next.js forwards the conversation and incoming-call socket paths.
# Local/self-host only. Vercel uses its native upgrade API, no listener port.
NEXT_WEBSOCKET_PORT=3030

# Browser ICE configuration. Use provider-issued TURN credentials for remote NATs.
NEXT_CHAT_ICE_SERVERS_JSON=[]

# Credentials stay in Chat; only the authorized Media backend may retrieve them.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET=

# Persistent DB-backed rate limit. Tune the deployment policy before enabling.
RATE_LIMIT_ENABLED=false
# Vercel Cron daily recovery (Hobby-compatible); Queue handles normal delivery.
# At least 32 bytes. A failed enqueue can wait until the next successful mutation
# or the daily recovery; Pro can opt into a minute schedule in vercel.json.
CRON_SECRET=
# Set automatically by Vercel. Leave blank locally.
VERCEL=
# Keep external OTLP exporters unset; telemetry policy disables export if configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
